---
import Base from '../../layouts/Base.astro';
import { readCollection, readYaml } from '../../lib/content';
import { getImage } from 'astro:assets';
import { portraitSource } from '../../lib/portraits';

const people = await readCollection('people');
const roster = await readYaml<Record<string, Array<string | {name: string; email?: string}>>>('people.yml');
const records = Object.fromEntries(await Promise.all(people.map(async ({slug, data}) => {
  const source = data.photo ? await portraitSource(data.photo) : null;
  const thumbnails = source ? await Promise.all([80, 160].map((width) =>
    getImage({ src: source, width, format: 'webp', quality: 85 }),
  )) : [];
  return [slug, {
  name: data.title,
  slug,
  title: data.role || '',
  email: data.email || '',
  photo: thumbnails[0]?.src || '',
  photoSrcset: thumbnails.map((image, index) => `${image.src} ${index === 0 ? 80 : 160}w`).join(', '),
  photoWidth: thumbnails[0]?.attributes.width,
  photoHeight: thumbnails[0]?.attributes.height,
  affiliation: data.affiliation || '',
  links: data.links || [],
}];
})));
---
<Base title="People">
  <link slot="head" rel="stylesheet" href="/assets/css/people.css" />

  <div class="archive people-archive">
    <div id="people-directory"></div>
    <noscript><p>The interactive directory requires JavaScript. Please enable it to view the team roster.</p></noscript>
  </div>

  <script is:inline define:vars={{ roster, records }}>
    window.peopleData = roster;
    window.peopleRecords = records;
    window.peopleBaseUrl = '/people/';
  </script>
  <script src="/assets/js/people.js" defer></script>
</Base>
